# Copy to your host's environment variables (Vercel/Netlify/Cloudflare).
# NEVER commit real keys.

# Required — from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx

# Required — the public URL of your storefront (no trailing slash)
SITE_URL=https://your-shop-domain.com

# Recommended — exact origin allowed to call the API (usually = SITE_URL)
ALLOWED_ORIGIN=https://your-shop-domain.com

# Optional — shown on the emailed invoice (default: OuiOui Prints)
SHOP_NAME=OuiOui Prints

# Optional — restrict shipping destinations (ISO codes, comma-separated).
# Leave unset to use the built-in worldwide default list.
# SHIP_COUNTRIES=US,CA,GB,JP,AU

# Required only for the webhook — from the Stripe webhook you create
STRIPE_WEBHOOK_SECRET=whsec_xxx
