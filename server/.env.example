# Set these in Vercel → Project → Settings → Environment Variables.
# NEVER commit real keys. NEVER put the secret key in the site/js.

# REQUIRED — your Stripe secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_or_sk_test_xxx

# OPTIONAL — business name shown on the emailed invoice (default: HARDCPY)
SHOP_NAME=HARDCPY

# OPTIONAL — only if you host the site on a DIFFERENT domain than the API
# SITE_URL=https://your-shop-domain.com
# ALLOWED_ORIGIN=https://your-shop-domain.com

# OPTIONAL — restrict shipping destinations (ISO codes). Unset = worldwide.
# SHIP_COUNTRIES=US,CA,GB,JP,AU

# REQUIRED ONLY FOR THE WEBHOOK — signing secret from the Stripe webhook
# STRIPE_WEBHOOK_SECRET=whsec_xxx
